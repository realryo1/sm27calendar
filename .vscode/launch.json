{
  // F5 で「Deploy: 一括（カレンダー＋運行情報）」を実行する。カレンダー（tools/deploy-pages.mjs）と、
  // 姉妹プロジェクト（hokkaido_delay/tools/deploy-pages.mjs）をそれぞれのリポジトリで同時に push・デプロイする
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deploy: push → GitHub Pages",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/deploy-pages.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Deploy: 運行情報（hokkaido_delay）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/hokkaido_delay/tools/deploy-pages.mjs",
      "cwd": "${workspaceFolder}/hokkaido_delay",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Deploy: 確認のみ（push・起動なし）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tools/deploy-pages.mjs",
      "args": ["--dry-run"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Deploy: 一括（カレンダー＋運行情報）",
      "configurations": ["Deploy: push → GitHub Pages", "Deploy: 運行情報（hokkaido_delay）"]
    }
  ]
}
